# Copy to .env and adjust as needed, then run with:
#   make run

# Port the server listens on
PORT=8080

# Directory containing your movie subfolders (default: movies)
MOVIES_DIR=/movies

# Directory containing your series subfolders (default: series). Each
# subfolder is a series name, containing "S01", "S02", ... season folders,
# each holding episode files like "Breaking Bad - s01e01.mp4" or
# "Breaking Bad - s01e01 - Pilot.mp4".
SERIES_DIR=/series

# TMDb v4 Read Access Token, used only by `make fetch-posters` to download poster art.
# Get a free token ("API Read Access Token") at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
